.level-list {
  padding: 24rpx;
}

.level-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.level-item--hover {
  opacity: 0.7;
}

.level-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.level-info {
  flex: 1;
  margin-left: 24rpx;
}

.level-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
}

.level-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.level-best {
  font-size: 24rpx;
  color: #2E9E5B;
  margin-right: 12rpx;
}

.level-arrow {
  font-size: 40rpx;
  color: #C4C4C4;
  line-height: 40rpx;
}
