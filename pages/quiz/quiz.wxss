.quiz,
.result {
  padding: 24rpx 32rpx 60rpx;
}

/* 进度 */
.progress-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.progress-text {
  font-size: 26rpx;
  color: #666666;
}

.correct-text {
  color: #2E9E5B;
}

.progress-bar {
  height: 10rpx;
  background: #E8E8EE;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: #D64545;
  border-radius: 5rpx;
}

/* 题目卡片 */
.card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.passage {
  background: #F6F7FB;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #444444;
  margin-bottom: 24rpx;
}

.question-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.question-id {
  font-size: 24rpx;
  color: #FFFFFF;
  background: #D64545;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  line-height: 1.6;
  font-weight: 600;
}

.question {
  font-size: 34rpx;
  font-weight: 600;
  color: #262626;
  line-height: 1.6;
  margin-bottom: 28rpx;
  flex: 1;
}

.option {
  display: flex;
  flex-direction: row;
  align-items: center;
  border: 2rpx solid #E8E8EE;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 18rpx;
}

.option--correct {
  border-color: #2E9E5B;
  background: #EDF9F1;
}

.option--wrong {
  border-color: #D64545;
  background: #FDEEEE;
}

.option--dim {
  opacity: 0.5;
}

.option-letter {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #F0F0F5;
  color: #666666;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.option--correct .option-letter {
  background: #2E9E5B;
  color: #FFFFFF;
}

.option--wrong .option-letter {
  background: #D64545;
  color: #FFFFFF;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  line-height: 1.5;
}

/* 解析 */
.explanation {
  margin-top: 8rpx;
  border-top: 2rpx solid #F0F0F5;
  padding-top: 24rpx;
}

.explanation-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E9E5B;
  margin-bottom: 12rpx;
}

.explanation-body {
  font-size: 26rpx;
  color: #777777;
  line-height: 1.6;
}

/* 按钮 */
.btn {
  margin-top: 32rpx;
  height: 92rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.btn--primary {
  background: #D64545;
  color: #FFFFFF;
}

.btn--plain {
  background: #FFFFFF;
  color: #666666;
  border: 2rpx solid #E0E0E6;
}

.btn--disabled {
  background: #E8E8EE;
  color: #AAAAAA;
}

/* 结果页 */
.result-card {
  margin-top: 60rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 64rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.result-label {
  font-size: 26rpx;
  color: #999999;
}

.result-score {
  margin-top: 24rpx;
  font-size: 96rpx;
  font-weight: 700;
  color: #262626;
}

.result-total {
  font-size: 40rpx;
  color: #AAAAAA;
  font-weight: 500;
}

.result-rate {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #D64545;
}

.result-comment {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #666666;
}

/* 空题库 */
.empty {
  padding: 200rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 28rpx;
  color: #AAAAAA;
}
