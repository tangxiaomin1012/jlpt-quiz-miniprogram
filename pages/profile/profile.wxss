.profile {
  padding: 24rpx 32rpx 60rpx;
}

/* 总览 */
.stat-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-row {
  display: flex;
  flex-direction: row;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #262626;
}

.stat-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 分区标题 */
.section-title {
  margin: 40rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #262626;
}

/* 最佳成绩表 */
.best-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.best-table {
  width: 100%;
}

.best-row {
  display: flex;
  flex-direction: row;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F0F0F5;
}

.best-row:last-child {
  border-bottom: none;
}

.best-cell {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #555555;
}

.best-cell--head {
  color: #999999;
  font-weight: 600;
}

.best-cell--name {
  flex: 1;
  text-align: left;
  color: #262626;
  font-weight: 600;
}

/* 最近记录 */
.record-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.record-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #AAAAAA;
}

.record-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F0F0F5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  flex: 1;
}

.record-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.record-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #AAAAAA;
}

.record-score {
  font-size: 30rpx;
  font-weight: 600;
  color: #D64545;
}

/* 清空 */
.clear-btn {
  margin-top: 48rpx;
  height: 88rpx;
  border-radius: 44rpx;
  border: 2rpx solid #E0E0E6;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999999;
}
